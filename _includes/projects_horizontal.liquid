<div class="card-item col" {% if project.hide %} hidden {% endif %}>
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card hoverable">
      <div class="row g-0">
        {% if project.img %}
          <div class="card-img col-md-3 col-sm-4 center-margin pl-4 pt-3" >
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-9{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h4 class="card-title">{{ project.title }}</h4>
            <p class="card-text">{{ project.description }} </p>




          </div>
        </div>
      </div>
    </div>
  </a>
</div>
